//Installation
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
$(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt update
sudo apt-get install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
sudo docker version
    Pour vérifier l'installation
pour éviter de taper sudo à chaque Commandes
    sudo usermod -aG docker $USER
    newgrp docker
        les changements ne sont pris en compte qu'après redémarrage, sauf avec la commande ci dessus

//Utilisation
Dockerfile -> build -> image -> run -> conteneur

//Dockerfile
FROM <image>:<version> : Image de base (ou FROM scratch pour aucune image)
WORKDIR <répertoire> : Répertoire dans le conteneur, pour résoudre les instructions qui ont besoin d'un chemin absolu
COPY <hote> <conteneur> : copie un répertoire de l'hote vers le conteneur.
    ATTENTION : Les chemins relatifs sont résolus à partir du dockerfile, non pas de WORKDIR
RUN <commande_shell> : écris des commandes dans le conteneur
ENV <variable> : écris des variables d'environnement, accessible pendant la phase d'éxecution, ex :
    ENV MESSAGE="hello"
ARG <variable> : écris les variables d'environnement accessibles pendant la phase de construction
ENTRYPOINT ["<chemin_executable>", "<instruction>"] : définis le processus parent (par ex: /usr/bin/dumb-init, un gestionnaire de processus)
LABEL <variable> ... : Permet d'ajouter des étiquettes sur l'image, par ex : LABEL description="Conteneur A pour l'application X"

//Tips
Pour l'adressage, par exemple de port, c'est toujours dans l'ordre <machine>:<conteneur>

//COMMANDES UTILES
//Images/////////////
docker run <image>:<tag>
    lance un conteneur à partir d'une image
    options :
        -d : processus en arrière plan
        -it : en mode interactif (--interactive (STDIN ouvert) + --tty (affichage correct des commandes))
        --name <nom> : nomme le conteneur, sert à le sélectionner pour certaines commandes
        --rm : supprime le conteneur quand celui ci est arrêté
docker pull <image>
    télécharge une image sans l'executer
docker images
    liste des images dispo localement
docker rmi
    supprimes une image
//Conteneurs/////////////
docker ps
    liste des conteneurs en cours d'execution
    options : -a
        liste les conteneurs stopés
docker rm <id_conteneur>
    supprime un conteneur (lister les conteneurs pour obtenir l'identifiant ave docker ps [-a])
docker top <id_conteneur>
    Affiche les processus du conteneur
docker logs <id_conteneur>
    Affiche les logs
    options :
        -f : logs en temps réel
docker start <id_conteneur>
    démarre un conteneur
docker stop <id_conteneur>
    Envoie un ordre d'arrêt du conteneur en laissant le processus se terminer
docker kill <id_conteneur>
    Tue le processus du conteneur sans ordre d'arrêt
docker cp <id_conteneur>:/conteneur/path /local/path
    Copie les fichiers d'un conteneur vers la machine locale
//Autres/////////////
docker tag <image>:<tag> <nouveau_tag>
    Le tag ets listé dans docker images comme une nouvelle ligne, mais il n'y a pas de nouvelle image créée (l'ID est le même)
docker rmi <image>:<tag>
    supprime le tag
docker commit <image_cible> <nouvelle_image>:<nouveau_tag>
    Snapshot du container docker dans une nouvelle image, sans sauvegarder le volume
    ex : docker commit image1 image1:backup

//Technique
Volume
    c'est un endroit qui relie l'interieur et l'exterieur d'un conteneur, comme un lien symbolique. De cette façon, les données persistent après arrêt ou destruction du conteneur.
Dockerfile
    -Layering : Instructions ajoutant un layer dans le dockerfile (RUN, COPY, ...)
    -Metadata : Instruction ajoutant des métadonnées à l'image (EXPOSE, ENV, MAINTAINER, ...)
