//Installation
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
$(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt update
sudo apt-get install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
docker version
    Pour vérifier l'installation

//Commandes utiles
sudo docker pull <nom_image>
    télécharge une image sans l'executer
sudo docker images
    liste des images dispo localement
sudo docker rmi
    supprimes une image
sudo docker ps
    liste des conteneurs en cours d'execution
    options : -a
        liste les conteneurs stopés
sudo docker rm <ID_conteneur>
    supprime un conteneur (lister les conteneurs pour obtenir l'identifiant ave docker ps [-a])

//Technique
Volume
    c'est un endroit qui relie l'interieur et l'exterieur d'un conteneur, comme un lien symbolique. De cette façon, les données persistent après arrêt ou destruction du conteneur.
