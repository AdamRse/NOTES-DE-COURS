// Créer un projet
Créer le répertoire du projet
    mkdir <répertoire du projet>
    cd <répertoire du projet>
Créer l'environement sandbox dans un répertoire .venv
    python3 -m venv .venv
source .venv/bin/activate

// Gérer le projet
Activer le projet
    source .venv/bin/activate
Installer un module
    pip install nom_du_module
Sauvegarder les dépendances
    pip freeze > requirements.txt

// Récupérer le projet github (git clone)
cd <répertoire du projet>
Créer l'environement virtuel
    python3 -m venv .venv
Activer la sandbox
    source .venv/bin/activate
Installer les dépendances
    pip install -r requirements.txt

// Quitter l'environement virtuel
deactivate
    A taper simplement dans le terminal.
    Attention, pas deSactivate

