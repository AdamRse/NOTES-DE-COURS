//Ajout .bashrc
Pour éviter de poluer le dossier $HOME
    export XDG_CONFIG_HOME="$HOME/.config"
    export XDG_DATA_HOME="$HOME/.local/data"
    export XDG_CACHE_HOME="$HOME/.cache"
    export XDG_STATE_HOME="$HOME/.local/data"
    export XDG_DATA_DIRS="$HOME/.local/data"
    export XDG_CONFIG_DIRS="$HOME/.config"
        Ne pas oublier de créer les répertoires associés :
            mkdir -p $XDG_CONFIG_HOME $XDG_DATA_HOME $XDG_CACHE_HOME $XDG_STATE_HOME $XDG_DATA_DIRS $XDG_CONFIG_DIRS
A tester
