//Initialiser le sudoer et interdire l'accès root
su -
apt update && apt install sudo
usermod -aG sudo <nom_utilisateur>
su <nom_utilisateur>
sudo nano /etc/ssh/sshd_config
	PermitRootLogin no
sudo rebot

//Nouvel utilisateur
Pour un humain
    sudo adduser <nomUser>
    sudo usermod -aG sudo <nomUser>
        passer l'utilisateur en admin
pour un service (minimaliste)
    sudo useradd --system --no-create-home --user-group --shell /usr/sbin/nologin <nomUser>

//Gérer le compte root si non donné :
sudo -i
passwd

//Passer en Français
sudo apt install locales
sudo dpkg-reconfigure locales
	sélectionner fr_FR
reboot

//authentification par clé SSH
En local
    ssh-keygen -t ed25519 -a 100
    ssh-copy-id -i <cheminCléSSH>.pub <user>@<serverIpOuDomaine>
Sur le serveur
    dans /etc/ssh/sshd_config :
        PubkeyAuthentication yes
        AuthorizedKeysFile .ssh/authorized_keys
            prendra /home/<user> comme racine
    sudo systemctl restart sshd
((Pour simplifier l'utilisation avec un hostname ssh dédié (en local) :
    dans ~/.ssh/config (créer si non présent)
        Host <nomPersonnaliséUtiliséParSsh>
        HostName <IpOuAdresse>
        User <nomUserServeur>
        IdentityFile <cléPrivéeGénérée>))
optionel : rajouter un alias pour simplifier encore la connexion.
    par ex : alias <commandeChoisie>="ssh <nomPersonnaliséUtiliséParSsh>"

//Message d'accueil
sudo nano /etc/motd

//authentification github
ssh-keygen -t ed25519 -C "bakaarion3@gmail.com"
ssh-add "<chemin de la clé>\<nomCléPrivée>"
Ajouter la clé publique sur github

//Timezones
timedatectl list-timezones | grep <MotCléTimezone (ex: Paris)>
    Vérifie que la timezone ciblée existe bien dans la liste interne
    par exemple pour la France : timedatectl list-timezones | grep Paris
sudo timedatectl set-timezone "<Ma/Timezone>"
    "Europe/Paris" en France
timedatectl status
    Pour vérifier que l'heure est bien réglée

//Pare-feu
sudo apt install ufw
autoriser un port
    sudo ufw allow <port>/<protocole>
        par ex : sudo ufw allow 9000/tcp (pour questDB)
    sudo ufw reload
vérifier le status du pare-feu
    sudo ufw status

//Nouvelles installations
php
    sudo apt install -y ca-certificates apt-transport-https software-properties-common curl lsb-release
    sudo wget -O /etc/apt/trusted.gpg.d/php.gpg https://packages.sury.org/php/apt.gpg
    echo "deb https://packages.sury.org/php/ $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/php.list
    sudo apt update -y
    Pour checker les versions dispos et que le repo de sury a bien été pris en compte : sudo apt policy php
        Le résultat est peu lisible mais regarder à Candidate: <nbCandidats>:<versionPHP><Reste string package>
nvm & npm & angular
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
        vérifier la dernière version sur https://github.com/nvm-sh/nvm
    nvm install --lts
    source ~/.bashrc
    npm install -g @angular/cli
    pour optimiser le chargement du bash, ajouter --no-use au chargement de nvm
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use  # This loads nvm
certbot
    sudo apt install snapd
    sudo snap install --classic certbot
    si la commande "certbot --nginx" (pour tester, puis annuler) ne fonctionne pas, mettre un alias dans ~/.bashrc
        alias certbot="sudo /snap/bin/certbot"
        source ~/.bashrc
phpmyadmin (https://www.phpmyadmin.net/downloads/)
    sudo apt install php-fpm php-mbstring php-bcmath php-xml php-mysql php-common php-gd php-cli php-curl php-zip php-gd
    télécharger le package
    sudo dpkg -t <nomPackage)
questDB (en tant que service systemd) (https://questdb.com/docs/deployment/systemd/ ET https://questdb.com/docs/quick-start/)
    sudo useradd --system --no-create-home --user-group --shell /usr/sbin/nologin questdb
    sudo apt install sudo apt install openjdk-17-jdk
    cd /opt/questdb/
    wget "https://dl.questdb.io/snapshots/questdb-latest-no-jre-bin.tar.gz"
    tar -xf questdb-latest-no-jre-bin.tar.gz
    ln -s <répertoireQuestDbDécompressé> latest
    sudo mkdir -p /var/lib/questdb && sudo chown -R questdb:questdb /var/lib/questdb
        là où va s'executer questdb, option -d dans la commande de ExecStart de questdb.service
    nano /etc/systemd/system/questdb.service
        copier les paramètres suivants :
            ```
            [Unit]
            Description=QuestDB Time Series Database
            Documentation=https://www.questdb.com/docs/
            After=network.target

            [Service]
            Type=simple
            User=questdb
            Group=questdb
            Restart=always
            RestartSec=2
            EnvironmentFile=/opt/questdb/latest/env.sh
            WorkingDirectory=/opt/questdb/latest
            ExecStart=/usr/bin/java \
            --add-exports java.base/jdk.internal.math=io.questdb \
            -p /opt/questdb/latest/questdb.jar \
            -m io.questdb/io.questdb.ServerMain \
            -DQuestDB-Runtime-66535 \
            -ea -Dnoebug \
            -XX:+UnlockExperimentalVMOptions \
            -XX:+AlwaysPreTouch \
            -XX:+UseParallelOldGC \
            -d /var/lib/questdb

            ExecReload=/bin/kill -s HUP $MAINPID

            # Security hardening
            ProtectSystem=full
            PrivateTmp=true
            NoNewPrivileges=true
            StandardError=syslog
            SyslogIdentifier=questdb
            LimitNOFILE=1048576

            [Install]
            WantedBy=multi-user.target
            ```
    modifications server.con optionelles
        Là où questdb s'execute, si aucun changement c'est : nano /var/lib/questdb/server.conf
        Décommenter : http.user et http.password pour créer un comtpe
    augmenter la taille des fichiers (warning dans l'interface web)
        nano /etc/sysctl.conf
            ajouter :
                fs.file-max=1048576
                vm.max_map_count=1048576
                    # fs.file-max : nombre max de fichiers ouverts simultanéement
                    # vm.max_map_count : zone mémoire qu'un processus peut utiliser

        sysctl -p
            rechargement de la configuration
    sudo systemctl daemon-reload
    sudo systemctl enable questdb.service
    sudo systemctl start questdb.service
    sudo systemctl status questdb.service
        optionnel, pour tester
    On peut tester l'injection avec curl (Attention, l'option -u uniquement si un utilisateur a été ajouté dans le conf.server) :
        curl "http://<IP>:9000/exec?query=INSERT%20INTO%20<table>%20VALUES(<VALEUR1>[,<valeur2>])" -u "<utilisateur>:<mot de passe>"

Reste
    sudo apt update -y && sudo apt install -y btop git nginx php bzip2 dnsutils
