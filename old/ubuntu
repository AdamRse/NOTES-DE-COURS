//Linux mint
//Désactiver raccourcis alt+molette souris
gsettings set org.cinnamon.desktop.wm.preferences mouse-button-modifier ''
    Pour voir quel est le raccourcis associé
        gsettings get org.cinnamon.desktop.wm.preferences mouse-button-modifier
            affiche '<Alt>' par défaut
    Pour changer et mettre la touche windows par exemple :
        gsettings set org.cinnamon.desktop.wm.preferences mouse-button-modifier '<Super>'
