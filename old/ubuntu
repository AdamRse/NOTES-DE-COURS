//Appeler un programme par son nom (comme un package)
nano ~/.bashrc
A la fin du fichier :
alias <nomProgramme>="nohup <cheminProgramme> >/dev/null 2>&1 &"
    Exemple postman :
    alias postman="nohup /home/adam/dev/repos_externes/postman/app/postman-agent --no-sandbox >/dev/null 2>&1 &"

//Recharger la console
    source ~/.bashrc

//Executer un script après veille
sudo nano /usr/lib/systemd/system-sleep/<monscript>
Exemple de script :
#!/bin/sh
    case "$1" in
        post)  # Après la sortie de veille
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] L'ordinateur est sorti de veille" >> "/home/adam/ckbnext-reboot.log"
            ;;
    esac
    exit 0

