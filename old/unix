Rechercher un dossier/fichier
    find / -xdev -name "<nomDossier>"
    find / -type f -name "<nomFichier>"
Afficher les ports USB
    lsusb
Vider le contenu d'un fichier
    > <fichier>
Ecrire dans un fichier
    echo -n "<texte>" > <fichier>
//Ajouter un user à un groupe
    usermod -aG <nom_du_groupe> <nom_de_l'utilisateur>
//Lien symbolique
    ln -s <fichierSourceExistant> <LienSymbolique>
